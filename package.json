{
  "name": "featureforge-ai",
  "version": "1.0.0",
  "main": "index.js",
  "author": "David Tran",
  "license": "SEE LICENSE IN LICENSE.txt",
  "description": "AI-powered BDD test generation and execution platform",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:ts && npm run lint:gherkin",
    "lint:fix": "eslint 'src/**/*.ts' '*.ts' --fix",
    "lint:ts": "eslint 'src/**/*.ts'",
    "lint:gherkin": "tsx src/tools/linting/gherkin-lint.ts",
    "clean:reports": "rm -rf reports && mkdir -p reports/screenshots reports/performance reports/a11y reports/cucumber reports/playwright reports/html",
    "clean:generated": "rm -rf src/features/generated src/steps/generated",
    "prepReport": "rimraf reports traces && mkdir -p reports/screenshots reports/accessibility",
    "cucumber": "TAGS='not @wip' node --import tsx node_modules/@cucumber/cucumber/bin/cucumber-js --config cucumber.mjs",
    "cucumber:archive": "npm run cucumber && tsx src/tools/reporting/archiveCucumberReports.ts",
    "cucumber:dev": "npm run clean:reports && cross-env ENV=dev npm run cucumber && npm run report:generate",
    "cucumber:staging": "npm run clean:reports && cross-env ENV=staging npm run cucumber",
    "cucumber:generated": "npm run clean:reports && cross-env ENV=dev npm run cucumber -- --tags '@generated'",
    "generate:dom": "tsx src/generators/dom/dom-generator-runner.ts",
    "generate:featureOpenAI": "tsx src/generators/llm/featureGeneratorOpenAI.ts",
    "feature:scaffold": "tsx src/generators/scaffolder/automationScaffolder.ts",
    "build": "npx tsc",
    "typecheck": "npx tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "codegen": "playwright codegen",
    "report:generate": "npx multiple-cucumber-html-reporter --reportDir reports/html --jsonDir reports/cucumber --reportName 'Consolidated Test Report' --displayDuration true",
    "report:open": "open reports/html/index.html",
    "seed:weaviate": "tsx src/plugins/ai/seed-weaviate.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:down:volumes": "docker compose down -v",
    "docker:restart": "docker compose restart",
    "feature:from-pdf": "tsx src/generators/pdf/pdf-to-feature.ts",
    "wait:prometheus": "npx wait-on http://localhost:9090",
    "perf:test": "ENABLE_TRACING=true npm run cucumber -- --tags '@performanceTest'",
    "perf:run": "npm run docker:up && npm run wait:prometheus && npm run perf:test",
    "perf:full": "npm run docker:restart && npm run wait:prometheus && npm run perf:test",
    "postinstall": "npx npm-force-resolutions",
    "scaffold:steps": "tsx src/generators/scaffolder/scaffolder.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@cucumber/cucumber": "11.0.1",
    "@cucumber/gherkin-streams": "^5.0.1",
    "@cucumber/html-formatter": "21.7.0",
    "@cucumber/messages": "^27.0.0",
    "@cucumber/pretty-formatter": "1.0.1",
    "@opentelemetry/api": "^1.4.1",
    "@opentelemetry/auto-instrumentations-node": "^0.41.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.41.0",
    "@opentelemetry/instrumentation-http": "^0.41.0",
    "@opentelemetry/resources": "^1.4.1",
    "@opentelemetry/sdk-node": "^0.41.2",
    "@opentelemetry/semantic-conventions": "^1.4.1",
    "@playwright/test": "1.48.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "4.22.0",
    "@types/k6": "^0.54.1",
    "@types/open": "^6.1.0",
    "axios-mock-adapter": "^2.1.0",
    "csv-parse": "^5.6.0",
    "csv-parser": "^3.0.0",
    "cucumber-console-formatter": "1.0.0",
    "date-fns": "^4.1.0",
    "glob": "^11.0.3",
    "globby": "^14.1.0",
    "inquirer": "^12.4.1",
    "moment": "^2.30.1",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.1",
    "pixelmatch": "5.3.0",
    "playwright": "1.48.2",
    "pngjs": "6.0.0",
    "weaviate-ts-client": "^2.2.0"
  },
  "devDependencies": {
    "@faker-js/faker": "9.1.0",
    "@types/chai": "^5.0.1",
    "@types/csv-parse": "^1.1.12",
    "@types/fs-extra": "11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/jsonfile": "^6.1.4",
    "@types/lodash": "4.17.12",
    "@types/node": "^22.15.30",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/prettier": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "as-a": "^2.2.7",
    "autoprefixer": "^10.4.20",
    "axe-html-reporter": "2.2.11",
    "axe-playwright": "2.0.3",
    "axios": "1.11.0",
    "chai": "^4.5.0",
    "chrome-launcher": "^1.2.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.2.1",
    "fs-extra": "^11.3.0",
    "gherkin-lint": "^4.2.4",
    "husky": "^9.1.6",
    "is-ci": "3.0.1",
    "lint-staged": "^15.2.10",
    "multiple-cucumber-html-reporter": "^3.9.3",
    "open": "^10.1.2",
    "path": "^0.12.7",
    "postcss": "^8.5.3",
    "prettier": "3.3.3",
    "prom-client": "^15.1.3",
    "read-excel-file": "5.8.6",
    "rimraf": "6.0.1",
    "standard-version": "9.5.0",
    "tailwindcss": "^4.0.9",
    "ts-node": "^10.9.2",
    "tsc-files": "1.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3",
    "wait-on": "^8.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.feature": [
      "npm run lint:gherkin"
    ]
  }
}
