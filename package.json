{
  "name": "featureforge-ai",
  "version": "1.0.0",
  "main": "index.js",
  "author": "David Tran",
  "license": "SEE LICENSE IN LICENSE.txt",
  "description": "AI-powered BDD test generation and execution platform",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:ts && npm run lint:gherkin",
    "lint:fix": "eslint 'src/**/*.ts' '*.ts' --fix",
    "lint:ts": "eslint 'src/**/*.ts'",
    "lint:gherkin": "tsx src/tools/linting/gherkin-lint.ts",
    "clean:reports": "rm -rf reports && mkdir -p reports/screenshots reports/performance reports/a11y reports/cucumber reports/playwright reports/html",
    "clean:generated": "rm -rf src/features/generated src/steps/generated",
    "prepReport": "rimraf reports traces && mkdir -p reports/screenshots reports/accessibility",
    "cucumber": "TAGS='not @wip' ENABLE_TRACING=true NODE_OPTIONS='--import tsx/esm' npx cucumber-js --config cucumber.mjs",
    "cucumber:archive": "npm run cucumber && tsx src/tools/reporting/archiveCucumberReports.ts",
    "cucumber:dev": "npm run clean:reports && cross-env ENV=dev ENABLE_TRACING=true npm run cucumber && npm run report:generate",
    "cucumber:staging": "npm run clean:reports && cross-env ENV=staging ENABLE_TRACING=true npm run cucumber",
    "cucumber:generated": "npm run clean:reports && cross-env ENV=dev ENABLE_TRACING=true npm run cucumber -- --tags '@generated'",
    "generate:dom": "tsx src/generators/dom/dom-generator-runner.ts",
    "generate:featureOpenAI": "tsx src/generators/llm/featureGeneratorOpenAI.ts",
    "feature:scaffold": "tsx src/generators/scaffolder/automationScaffolder.ts",
    "build": "npx tsc",
    "typecheck": "npx tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "codegen": "playwright codegen",
    "report:generate": "tsx src/tools/reporting/generateReport.ts",    
    "report:open": "open reports/html/index.html",
    "seed:weaviate": "tsx src/plugins/ai/seed-weaviate.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:down:volumes": "docker compose down -v",
    "docker:restart": "docker compose restart",
    "feature:from-pdf": "tsx src/generators/pdf/pdf-to-feature.ts",
    "wait:prometheus": "npx wait-on http://localhost:9090",
    "perf:test": "ENABLE_TRACING=true npm run cucumber -- --tags '@performanceTest'",
    "perf:run": "npm run docker:up && npm run wait:prometheus && npm run perf:test",
    "perf:full": "npm run docker:restart && npm run wait:prometheus && npm run perf:test",
    "postinstall": "npx npm-force-resolutions",
    "scaffold:steps": "tsx src/generators/scaffolder/scaffolder.ts",
    "scan:api": "tsx src/generators/scanner/cli.ts scan --dir ./docs/api",
    "flows:list": "tsx src/generators/scanner/cli.ts flows",
    "generate:scanner": "tsx src/generators/scanner/cli.ts generate --all",
    "generate:hybrid": "tsx src/generators/scanner/hybrid-cli.ts --dir ./docs/api",
    "scan:clear-cache": "tsx src/generators/scanner/cli.ts clear-cache",
    "otel:up": "docker compose up -d",
    "otel:down": "docker compose down",
    "otel:restart": "docker compose restart",
    "otel:status": "docker ps --format \"table {{.Names}}\\t{{.Status}}\\t{{.Ports}}\" | grep -E \"NAME|jaeger|prometheus|grafana|otel|weaviate\"",
    "otel:open": "open http://localhost:16686 && open http://localhost:9090 && open http://localhost:3000",
    "otel:start": "npm run otel:up && npm run wait:prometheus && npm run otel:open"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@cucumber/cucumber": "13.2.1",
    "@cucumber/gherkin-streams": "^5.0.1",
    "@cucumber/html-formatter": "21.7.0",
    "@cucumber/messages": "^27.2.0",
    "@cucumber/pretty-formatter": "1.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-fs": "^0.37.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@playwright/test": "1.62.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "4.22.0",
    "@types/k6": "^0.54.1",
    "@types/open": "^6.1.0",
    "axios-mock-adapter": "^2.1.0",
    "csv-parse": "^5.6.0",
    "csv-parser": "^3.0.0",
    "cucumber-console-formatter": "1.0.0",
    "date-fns": "^4.1.0",
    "glob": "^11.0.3",
    "globby": "^14.1.0",
    "graphql": "^16.13.1",
    "inquirer": "^12.4.1",
    "moment": "^2.30.1",
    "ollama": "^0.6.3",
    "openai": "7.4.0",
    "pdf-parse": "^1.1.1",
    "pixelmatch": "5.3.0",
    "playwright": "1.62.1",
    "pngjs": "6.0.0",
    "weaviate-client": "^3.13.1"
  },
  "devDependencies": {
    "@faker-js/faker": "9.1.0",
    "@types/chai": "^5.2.3",
    "@types/csv-parse": "^1.2.5",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.10",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonfile": "^6.1.4",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/prettier": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "as-a": "^2.2.8",
    "autoprefixer": "^10.4.27",
    "axe-html-reporter": "2.2.11",
    "axe-playwright": "^2.2.2",
    "axios": "^1.19.0",
    "chai": "^4.5.0",
    "chrome-launcher": "^1.2.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "fs-extra": "^11.4.0",
    "gherkin-lint": "^4.2.4",
    "husky": "^9.1.6",
    "is-ci": "3.0.1",
    "js-yaml": "^4.1.1",
    "lint-staged": "^15.2.10",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "open": "^10.1.2",
    "path": "^0.12.7",
    "postcss": "^8.5.8",
    "prettier": "^3.9.6",
    "prom-client": "^15.1.3",
    "read-excel-file": "5.8.6",
    "rimraf": "^6.1.3",
    "standard-version": "9.5.0",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.2",
    "tsc-files": "1.1.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.feature": [
      "npm run lint:gherkin"
    ]
  }
}
